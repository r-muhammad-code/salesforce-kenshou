    <decisions>
        <name>decision_DeterminePostApprovalAction</name>
        <label>承認後処理を判定</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>SendApprovalNotification</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>デフォルトの結果</defaultConnectorLabel>
        <rules>
            <name>PermanentDeregistrationAction</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.application_category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>永久抹消条件または書類なし案件の買取</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_PurchaseOpportunityProcessingDivision</targetReference>
            </connector>
            <label>永久抹消対応</label>
        </rules>
        <rules>
            <name>CancellationAction</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.application_category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>台帳作成済みキャンセル・在庫削除</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_PurchaseOpportunityForCancellation</targetReference>
            </connector>
            <label>台帳作成済みキャンセル・在庫削除</label>
        </rules>
    </decisions>
