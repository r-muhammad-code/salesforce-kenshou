<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>assign_ClearDuplicateCount</name>
        <label>完了レコードの重複件数をクリア</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>loop_SetDuplicateCount.DuplicateCount__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>col_SalesManagementToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>loop_SetDuplicateCount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>loop_SetDuplicateCount</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>assign_IncrementActiveCount</name>
        <label>進行中件数を1増やす</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_ActiveCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>loop_SalesManagement</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>assign_SetDuplicateCount</name>
        <label>進行中レコードに重複件数を設定</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>loop_SetDuplicateCount.DuplicateCount__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formula_DuplicateCount</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>col_SalesManagementToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>loop_SetDuplicateCount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>loop_SetDuplicateCount</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>decision_IsCurrentInProgress</name>
        <label>進行中レコードか判定</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>assign_ClearDuplicateCount</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>完了・キャンセル</defaultConnectorLabel>
        <rules>
            <name>is_CurrentInProgress</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>loop_SetDuplicateCount.InProgress__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>assign_SetDuplicateCount</targetReference>
            </connector>
            <label>進行中</label>
        </rules>
    </decisions>
    <decisions>
        <name>decision_IsInProgress</name>
        <label>進行中か判定</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>loop_SalesManagement</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>進行中ではない</defaultConnectorLabel>
        <rules>
            <name>is_InProgress</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>loop_SalesManagement.InProgress__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>assign_IncrementActiveCount</targetReference>
            </connector>
            <label>進行中</label>
        </rules>
    </decisions>
    <description>同一取引先に紐づく進行中の営業管理件数を再計算し、各営業管理レコードの重複件数を更新する。</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_DuplicateCount</name>
        <dataType>Number</dataType>
        <expression>IF(
{!var_ActiveCount} &gt; 1,
{!var_ActiveCount} - 1,
0)</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>営業管理重複再計算 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>営業管理重複再計算</label>
    <loops>
        <name>loop_SalesManagement</name>
        <label>営業管理を繰り返し確認</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>get_SalesManagementByAccount</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>decision_IsInProgress</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>loop_SetDuplicateCount</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>loop_SetDuplicateCount</name>
        <label>営業管理の重複件数を設定</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>get_SalesManagementByAccount</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>decision_IsCurrentInProgress</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>update_DuplicateCounts</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>get_SalesManagementByAccount</name>
        <label>同一取引先の営業管理を取得</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>loop_SalesManagement</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>var_AccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>SalesManagement__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>update_DuplicateCounts</name>
        <label>重複件数を一括更新</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>col_SalesManagementToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>get_SalesManagementByAccount</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>col_SalesManagementToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>SalesManagement__c</objectType>
    </variables>
    <variables>
        <name>var_AccountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>var_ActiveCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
