<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>assign_SetCleanupActiveCount</name>
        <label>再判定対象取引先の進行中件数を設定</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_CleanupActiveCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>get_ActiveSalesManagementForCleanup</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>decision_CleanupActiveCount</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>assign_SetCurrentAccountForCleanup</name>
        <label>現在取引先を再判定対象に設定</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_CleanupAccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Account__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>get_ActiveSalesManagementForCleanup</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>assign_SetPriorAccountForCleanup</name>
        <label>旧取引先を再判定対象に設定</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_CleanupAccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record__Prior.Account__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>get_ActiveSalesManagementForCleanup</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>decision_CleanupActiveCount</name>
        <label>再判定対象取引先の進行中件数を判定</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>decision_CurrentRecordInProgress</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>0件または2件以上</defaultConnectorLabel>
        <rules>
            <name>cleanup_OnlyOneActive</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_CleanupActiveCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_ClearSingleActiveDuplicateFlag</targetReference>
            </connector>
            <label>進行中営業管理が1件のみ</label>
        </rules>
    </decisions>
    <decisions>
        <name>decision_CurrentRecordInProgress</name>
        <label>現在レコードの進行状態を判定</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>update_ClearCurrentDuplicateFlag</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>現在レコードが進行中ではない</defaultConnectorLabel>
        <rules>
            <name>current_RecordInProgress</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>formula_CurrentInProgress</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>get_OtherActiveSalesManagement</targetReference>
            </connector>
            <label>現在レコードが進行中</label>
        </rules>
    </decisions>
    <decisions>
        <name>decision_DetermineCleanupAccount</name>
        <label>再判定対象取引先を判定</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>decision_CurrentRecordInProgress</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>デフォルトの結果</defaultConnectorLabel>
        <rules>
            <name>cleanup_PriorAccount</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Account__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Account__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>assign_SetPriorAccountForCleanup</targetReference>
            </connector>
            <label>旧取引先を再判定</label>
        </rules>
        <rules>
            <name>cleanup_CurrentAccount</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>formula_CurrentInProgress</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>assign_SetCurrentAccountForCleanup</targetReference>
            </connector>
            <label>現在取引先を再判定</label>
        </rules>
    </decisions>
    <decisions>
        <name>decision_HasOtherActiveSalesManagement</name>
        <label>他の進行中営業管理の有無を判定</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>update_ClearCurrentDuplicateFlag</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>他の進行中営業管理なし</defaultConnectorLabel>
        <rules>
            <name>has_OtherActiveSalesManagement</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_OtherActiveSalesManagement.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_SetCurrentDuplicateFlagTrue</targetReference>
            </connector>
            <label>他の進行中営業管理あり</label>
        </rules>
    </decisions>
    <description>営業管理の作成、取引先変更、引取・書類・振込ステータス変更時に、
同一取引先の営業管理重複件数を再計算する</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_CurrentInProgress</name>
        <dataType>Boolean</dataType>
        <expression>NOT(
    AND(
        OR(
            ISPICKVAL({!$Record.Pickup_status__c}, &quot;完了&quot;),
            ISPICKVAL({!$Record.Pickup_status__c}, &quot;案件キャンセル&quot;)
        ),
        OR(
            ISPICKVAL({!$Record.Document_status__c}, &quot;完了&quot;),
            ISPICKVAL({!$Record.Document_status__c}, &quot;案件キャンセル&quot;)
        ),
        OR(
            ISPICKVAL({!$Record.Transfer_status__c}, &quot;振込完了&quot;),
            ISPICKVAL({!$Record.Transfer_status__c}, &quot;案件キャンセル&quot;)
        )
    )
)</expression>
    </formulas>
    <interviewLabel>営業管理重複再計算トリガー {!$Flow.CurrentDateTime}</interviewLabel>
    <label>営業管理重複再計算トリガー</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>get_ActiveSalesManagementForCleanup</name>
        <label>再判定対象取引先の進行中営業管理を取得</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>assign_SetCleanupActiveCount</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>var_CleanupAccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>InProgress__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <limit>
            <numberValue>2.0</numberValue>
        </limit>
        <object>SalesManagement__c</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>get_OtherActiveSalesManagement</name>
        <label>同一取引先の他の進行中営業管理を取得</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>decision_HasOtherActiveSalesManagement</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Account__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>InProgress__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>SalesManagement__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>update_ClearCurrentDuplicateFlag</name>
        <label>現在レコードの重複フラグをFalseに更新</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>DuplicateFlag__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>update_ClearSingleActiveDuplicateFlag</name>
        <label>単独進行中営業管理の重複フラグを解除</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>decision_CurrentRecordInProgress</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>var_CleanupAccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>InProgress__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>DuplicateFlag__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>DuplicateFlag__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>SalesManagement__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>update_SetCurrentDuplicateFlagTrue</name>
        <label>現在レコードの重複フラグをTrueに更新</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>update_SetOtherDuplicateFlagTrue</targetReference>
        </connector>
        <inputAssignments>
            <field>DuplicateFlag__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>update_SetOtherDuplicateFlagTrue</name>
        <label>他の進行中営業管理の重複フラグをTrueに更新</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>get_OtherActiveSalesManagement.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>DuplicateFlag__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>SalesManagement__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>decision_DetermineCleanupAccount</targetReference>
        </connector>
        <filterFormula>OR(
    AND(
        ISNEW(),
        NOT(ISBLANK({!$Record.Account__c}))
    ),
    ISCHANGED({!$Record.Account__c}),
    AND(
        NOT(ISBLANK({!$Record.Account__c})),
        OR(
            ISCHANGED({!$Record.Pickup_status__c}),
            ISCHANGED({!$Record.Document_status__c}),
            ISCHANGED({!$Record.Transfer_status__c})
        )
    )
)</filterFormula>
        <object>SalesManagement__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_CleanupAccountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>var_CleanupActiveCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
