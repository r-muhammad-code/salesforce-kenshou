<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>営業管理の作成、取引先変更、引取・書類・振込ステータス変更時に、
同一取引先の営業管理重複件数を再計算する</description>
    <environments>Default</environments>
    <interviewLabel>営業管理重複再計算トリガー {!$Flow.CurrentDateTime}</interviewLabel>
    <label>営業管理重複再計算トリガー</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>SalesManagement_DuplicateRecalculationTrigger</targetReference>
        </connector>
        <filterFormula>AND(
    NOT(ISBLANK({!$Record.Account__c})),
    OR(
        ISNEW(),
        ISCHANGED({!$Record.Account__c}),
        ISCHANGED({!$Record.Pickup_status__c}),
        ISCHANGED({!$Record.Document_status__c}),
        ISCHANGED({!$Record.Transfer_status__c})
    )
)</filterFormula>
        <object>SalesManagement__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <description>営業管理レコードの取引先IDを渡し、同一取引先の重複件数を再計算する。</description>
        <name>SalesManagement_DuplicateRecalculationTrigger</name>
        <label>営業管理重複再計算トリガー</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>SalesManagement_RecalculateDuplicates</flowName>
        <inputAssignments>
            <name>var_AccountId</name>
            <value>
                <elementReference>$Record.Account__r.Id</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
