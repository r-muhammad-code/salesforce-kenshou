<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Approve_or_Return</fullName>
    <active>true</active>
    <errorConditionFormula>Transfer_request_approved__c = true &amp;&amp; Transfer_request_return__c = true</errorConditionFormula>
    <errorDisplayField>Transfer_request_approved__c</errorDisplayField>
