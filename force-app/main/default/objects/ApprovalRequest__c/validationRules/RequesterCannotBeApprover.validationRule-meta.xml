<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RequesterCannotBeApprover</fullName>
    <active>true</active>
    <description>申請者本人を第1承認者として設定できないようにする。</description>
    <errorConditionFormula>AND(
        NOT(ISBLANK(Requester__c)),
        NOT(ISBLANK(AssignedApprover__c)),
        Requester__c = AssignedApprover__c
    )</errorConditionFormula>
    <errorMessage>申請者本人を第1承認者に設定することはできません。</errorMessage>
</ValidationRule>
