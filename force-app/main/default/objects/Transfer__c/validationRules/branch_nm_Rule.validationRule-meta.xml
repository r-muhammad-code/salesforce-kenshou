<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>branch_nm_Rule</fullName>
    <active>true</active>
    <description>仕入営業レコードタイプのみ適用。山本</description>
    <errorConditionFormula>RecordType.DeveloperName = &quot;Buyer&quot; &amp;&amp;REGEX(branch_nm__c, &quot;.*[0-9].*&quot;)</errorConditionFormula>
    <errorMessage>支店名に半角数字を入力することはできません。</errorMessage>
</ValidationRule>
