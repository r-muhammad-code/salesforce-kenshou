<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cannot_select_previous_date</fullName>
    <active>true</active>
    <errorConditionFormula>(ScheduleAdjustmentRequestDate__c  &gt; Pickup_Preferred_date1_hs__c || ScheduleAdjustmentRequestDate__c  &gt;Pickup_Preferred_date2_hs__c ||  ScheduleAdjustmentRequestDate__c  &gt;Pickup_Preferred_date3_hs__c )  &amp;&amp; ScheduleAdjustmentRequestDate__c &gt;= DATE(2024, 5, 1)</errorConditionFormula>
    <errorMessage>引取希望日は引取依頼作成日より前の日付を選択できません</errorMessage>
</ValidationRule>
