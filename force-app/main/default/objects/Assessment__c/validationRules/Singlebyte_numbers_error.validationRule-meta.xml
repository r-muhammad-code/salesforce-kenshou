<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Singlebyte_numbers_error</fullName>
    <active>true</active>
    <description>山本</description>
    <errorConditionFormula>(LEN( registerdAtYear__c ) &lt;&gt; 4  || 
NOT(REGEX(  registerdAtYear__c  , &quot;^[0-9]*$&quot; ))) &amp;&amp; 
NOT(REGEX( registerdAtYear__c ,&quot;&quot; ))</errorConditionFormula>
    <errorDisplayField>registerdAtYear__c</errorDisplayField>
    <errorMessage>半角数字4桁で入力してください。</errorMessage>
</ValidationRule>
